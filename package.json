{
  "name": "salt-hawthorn-whitby-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/package-worker.mjs && node scripts/validate-worker.mjs",
    "build:site": "next build",
    "start": "next dev",
    "security:scan": "node scripts/scan-repository-secrets.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "qa:release": "node scripts/ai-release-gate.mjs",
    "release:gate": "pnpm run security:scan && pnpm run security:audit && pnpm run build:site && pnpm run qa:release"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
